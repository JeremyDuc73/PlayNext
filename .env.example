# API
NODE_ENV=development
# 0.0.0.0 = reachable from Windows host when API runs in WSL
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info

# Database
DATABASE_URL=postgres://playnext:playnext@127.0.0.1:5432/playnext
REDIS_URL=redis://127.0.0.1:6379

# Public URLs
# Use localhost (not 127.0.0.1) for browser URLs so the session cookie is same-site with the UI.
APP_URL=http://localhost:1420
API_URL=http://localhost:3001
WEB_URL=http://localhost:4321

# Auth / sessions
SESSION_SECRET=change-me-to-a-long-random-string

# Discord OAuth2 (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3001/auth/discord/callback

# Optional later
# STEAM_WEB_API_KEY=
# IGDB_CLIENT_ID=
# IGDB_CLIENT_SECRET=
# SENTRY_DSN=
