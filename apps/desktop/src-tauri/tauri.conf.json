{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PlayNext",
  "version": "0.2.1",
  "identifier": "fr.playnext.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PlayNext",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://fonts.bunny.net; font-src 'self' https://fonts.bunny.net; connect-src 'self' http://localhost:3001 https://api.playnext.jeremyduc.dev ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "playnext"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZEN0YyOTdCOTJFQzYwNApSV1FFeGk2NWwvTFhEMGJRbll2Y09tVHpSSFVtaEZuYThhTVI3am1RQUxUSmVnako0VVFpeFRTNAo=",
      "endpoints": [
        "https://github.com/JeremyDuc73/PlayNext/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "publisher": "PlayNext",
    "copyright": "Copyright © 2026 PlayNext",
    "category": "Game",
    "shortDescription": "Choisir ensemble.",
    "longDescription": "PlayNext réunit les bibliothèques du groupe et organise un vote pour choisir un jeu.",
    "homepage": "https://github.com/JeremyDuc73/PlayNext",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "PlayNext",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "windows/installer-header.bmp",
        "sidebarImage": "windows/installer-sidebar.bmp",
        "uninstallerHeaderImage": "windows/installer-header.bmp",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  }
}
