---
import "../styles/global.css";

const { title = "PlayNext — Choisir ensemble", description = "PlayNext aide un groupe d’amis à choisir un jeu à partir de leurs bibliothèques." } = Astro.props;
const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#08090b" />
    <link rel="icon" type="image/svg+xml" href="/playnext.svg" />
    <title>{title}</title>
  </head>
  <body>
    <div class="site-shell">
      <aside class="rail" aria-hidden="true">
        <span>CHOISIR ENSEMBLE</span>
      </aside>
      <div class="page">
        <header class="topbar">
          <a class="brand" href="/">
            <img src="/playnext.svg" alt="" />
            <span>PlayNext</span>
          </a>
          <nav class="nav" aria-label="Navigation principale">
            <a href="/" aria-current={pathname === "/" ? "page" : undefined}>Accueil</a>
            <a href="/download" aria-current={pathname === "/download" ? "page" : undefined}>Télécharger</a>
            <a href="/docs" aria-current={pathname === "/docs" ? "page" : undefined}>Fonctionnement</a>
          </nav>
          <span class="top-status">Windows · Application</span>
        </header>

        <main>
          <slot />
        </main>

        <footer class="footer">
          <span>PlayNext · Choisir ensemble.</span>
          <nav aria-label="Navigation secondaire">
            <a href="/download">Télécharger</a>
            <a href="/docs">Fonctionnement</a>
            <a href="/legal">Mentions</a>
            <a href="https://github.com/JeremyDuc73/PlayNext">GitHub</a>
          </nav>
        </footer>
      </div>
    </div>
  </body>
</html>
