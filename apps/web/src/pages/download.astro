---
import Base from "../layouts/Base.astro";

const downloadUrl =
  "https://github.com/JeremyDuc73/PlayNext/releases/latest/download/PlayNext-Setup.exe";
---

<Base
  title="Télécharger PlayNext — Windows"
  description="Télécharger PlayNext pour Windows."
>
  <section class="section">
    <div class="prose">
      <p class="eyebrow">Application Windows</p>
      <span class="accent"></span>
      <h1>Installer PlayNext.</h1>
      <p>
        Téléchargez l’installateur, ouvrez-le, puis connectez-vous avec Discord
        pour rejoindre ou créer un groupe.
      </p>
      <div class="actions">
        <a class="button" href={downloadUrl}>Télécharger l’installateur</a>
        <a
          class="button secondary"
          href="https://github.com/JeremyDuc73/PlayNext/releases"
        >
          Voir les versions
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <h2>Avant de commencer</h2>
      <p>Quelques informations utiles, rien de plus.</p>
    </div>
    <div class="manifesto">
      <div>
        <strong>Système</strong>
        <p>Windows 10 ou Windows 11.</p>
      </div>
      <div>
        <strong>Connexion</strong>
        <p>Une connexion internet est nécessaire pour Discord et la synchronisation.</p>
      </div>
      <div>
        <strong>Installation</strong>
        <p>L’application s’installe pour votre utilisateur, sans privilèges administrateur.</p>
      </div>
      <div>
        <strong>Signature</strong>
        <p>
          Les versions publiques sont signées avec l’aide de
          <a href="https://signpath.org/">SignPath Foundation</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="download-box">
      <div>
        <p class="eyebrow">Projet public</p>
        <h3>Une question sur une version ?</h3>
        <p>Consultez les notes de version et les problèmes connus sur GitHub.</p>
      </div>
      <a class="button secondary" href="https://github.com/JeremyDuc73/PlayNext">
        Ouvrir GitHub
      </a>
    </div>
  </section>
</Base>
