<Base title="Mentions — PlayNext">
  <section class="section">
    <div class="prose">
      <p class="eyebrow">Informations</p>
      <span class="accent"></span>
      <h1>Mentions.</h1>
      <h3>Projet</h3>
      <p>PlayNext est un projet personnel en cours de développement.</p>
      <h3>Services externes</h3>
      <p>
        PlayNext peut utiliser Discord, Steam, Microsoft/Xbox, Epic et des
        services de catalogue selon les fonctionnalités activées.
      </p>
      <h3>Données</h3>
      <p>
        Consulte la documentation de l’application pour connaître les données
        locales et les données synchronisées avec le serveur.
      </p>
    </div>
  </section>
</Base>
